# --- Actual Budget server ---
ACTUAL_SERVER_URL=https://actual.example.com
ACTUAL_PASSWORD=change-me
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# Optional; defaults to /tmp/actual-data on Vercel (the only writable path).
ACTUAL_DATA_DIR=/tmp/actual-data

# --- Cron auth (Vercel Cron presents this as `Authorization: Bearer <secret>`) ---
CRON_SECRET=change-me

# --- Investec reference plugin ---
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
INVESTEC_WEBHOOK_SECRET=
# JSON map of Investec accountId -> Actual account UUID
INVESTEC_ACCOUNT_MAP={"1234567890":"00000000-0000-0000-0000-000000000000"}
