{
  "name": "actual-bank-engine",
  "version": "0.1.0",
  "description": "Extensible banking → Actual Budget integration engine for Vercel Serverless.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "discover": "node --env-file=.env --import tsx scripts/discover.ts",
    "reconcile": "node --env-file=.env --import tsx scripts/reconcile.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actual-app/api": "^26.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vercel/node": "^3.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
